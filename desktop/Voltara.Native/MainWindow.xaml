<Window x:Class="Voltara.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voltara Nativo • Controle da Casa"
        Width="1140" Height="790" MinWidth="860" MinHeight="630"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C13" Foreground="#F5F3FF"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundCard" Color="#171620"/>
    <SolidColorBrush x:Key="BorderCard" Color="#383044"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#B9B2C5"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#403055"/>
      <Setter Property="Foreground" Value="#F5F3FF"/>
      <Setter Property="BorderBrush" Value="#644780"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,3,7,3"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#7A49B7"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0C0D18"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="#534361"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#EDE8F7"/>
      <Setter Property="Foreground" Value="#1A1523"/>
      <Setter Property="BorderBrush" Value="#534361"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
    </Style>
    <Style TargetType="DatePicker">
      <Setter Property="Background" Value="#EDE8F7"/>
      <Setter Property="Foreground" Value="#171620"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BackgroundCard}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="PageHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <DataTemplate x:Key="RecordTemplate">
      <Border BorderBrush="#40354D" BorderThickness="0,0,0,1" Padding="0,10">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Excluir" Tag="{Binding}"
                  Click="DeleteRecord_Click" Margin="8,0,0,0"
                  Padding="9,6" MinHeight="34"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding AmountFormatted}"
                     Foreground="#DAB6FE" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="10,0"/>
          <StackPanel>
            <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" Foreground="#AAA3B9" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="225"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#120F1D" BorderBrush="#34283F" BorderThickness="0,0,1,0">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#2A2237" BorderBrush="#51406C" BorderThickness="1"
                  CornerRadius="12" Padding="10,12" Margin="0,10,0,6">
            <StackPanel>
              <TextBlock Text="NATIVO • WINDOWS" FontSize="10" Foreground="#B8A6DB" FontWeight="Bold"/>
              <TextBlock x:Name="SidebarSession" Text="Não conectado" Margin="0,5,0,0"
                         TextWrapping="Wrap" FontSize="12" Foreground="#E2DDEE"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="ϟ Voltara" Foreground="#B388FF" FontSize="27" FontWeight="Bold" Margin="8,12,0,6"/>
          <TextBlock Text="CONTROLE DA CASA" Foreground="#8C849F" FontSize="10" Margin="10,0,0,28"/>
          <Button Style="{StaticResource NavButton}" Content="⌂  Visão geral" Tag="dashboard" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="◈  Gastos diários" Tag="expenses" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="💧  Conta de água" Tag="water" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="ϟ  Conta de luz" Tag="energy" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="♧  Minha casa" Tag="home" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="♧  Compartilhar" Tag="family" Click="Navigate_Click"/>
          <Separator Background="#40354D" Margin="6,18"/>
          <Button Style="{StaticResource NavButton}" Content="⟳  Atualizar dados" Click="Refresh_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="34"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="#34283F" BorderThickness="0,0,0,1" Background="#120F1D">
        <DockPanel Margin="25,0">
          <TextBlock DockPanel.Dock="Right" x:Name="HeaderState" Text="Voltara Nativo 0.1"
                     Foreground="#A99BBB" VerticalAlignment="Center" FontSize="12"/>
          <TextBlock Text="VOL T A R A  /  DESKTOP" Foreground="#DCD6EB"
                     VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,23,28,32">
          <!-- Dashboard -->
          <StackPanel x:Name="DashboardPage">
            <TextBlock Text="Visão geral" Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Seu painel financeiro nativo do Windows, com informações do Supabase."
                       Style="{StaticResource Muted}" Margin="0,0,0,20"/>
            <UniformGrid Columns="3" Margin="0,0,0,12">
              <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="GASTOS DESTE MÊS" Foreground="#B9B2C5" FontSize="11"/>
                  <TextBlock x:Name="ExpenseTotal" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,5"/>
                  <TextBlock Text="Anotações familiares" Foreground="#9B91AE" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="ÚLTIMA CONTA DE ÁGUA" Foreground="#B9B2C5" FontSize="11"/>
                  <TextBlock x:Name="WaterTotal" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,5"/>
                  <TextBlock Text="Leitura cadastrada" Foreground="#9B91AE" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="ÚLTIMA CONTA DE LUZ" Foreground="#B9B2C5" FontSize="11"/>
                  <TextBlock x:Name="EnergyTotal" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,5"/>
                  <TextBlock Text="Fatura cadastrada" Foreground="#9B91AE" FontSize="12"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Atividade recente" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Os registros são carregados diretamente da casa compartilhada. A cada atualização, conferimos o Supabase sem abrir um site."
                           Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecordTemplate}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Gastos -->
          <StackPanel x:Name="ExpensesPage" Visibility="Collapsed">
            <TextBlock Text="Gastos diários" Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Lançamentos associados à casa, com o cômodo opcional."
                       Style="{StaticResource Muted}" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Registrar novo gasto" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock Text="Dia" Foreground="#B9B2C5"/>
                <DatePicker x:Name="ExpenseDate"/>
                <TextBlock Text="Anotação" Foreground="#B9B2C5"/>
                <TextBox x:Name="ExpenseNote" MaxLength="240"/>
                <TextBlock Text="Valor (R$)" Foreground="#B9B2C5"/>
                <TextBox x:Name="ExpenseAmount" MaxLength="15"/>
                <TextBlock Text="Cômodo (opcional)" Foreground="#B9B2C5"/>
                <ComboBox x:Name="ExpenseRoom" SelectedIndex="0">
                  <ComboBoxItem Tag="" Content="Gasto geral / nenhum cômodo"/>
                  <ComboBoxItem Tag="sala" Content="Sala grande"/>
                  <ComboBoxItem Tag="copa" Content="Copa"/>
                  <ComboBoxItem Tag="cozinha" Content="Cozinha americana"/>
                  <ComboBoxItem Tag="banheiro" Content="Banheiro"/>
                  <ComboBoxItem Tag="quarto1" Content="Quarto grande 1"/>
                  <ComboBoxItem Tag="escritorio" Content="Escritório"/>
                  <ComboBoxItem Tag="quarto2" Content="Quarto grande 2"/>
                </ComboBox>
                <Button Content="Salvar gasto" Click="AddExpense_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Histórico de gastos" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl x:Name="ExpenseList" ItemTemplate="{StaticResource RecordTemplate}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Água -->
          <StackPanel x:Name="WaterPage" Visibility="Collapsed">
            <TextBlock Text="Conta de água" Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Registre as faturas reais e acompanhe os gastos com água."
                       Style="{StaticResource Muted}" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Cadastrar fatura de água" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Mês (AAAA-MM)" Foreground="#B9B2C5"/>
                <TextBox x:Name="WaterMonth" MaxLength="7"/>
                <TextBlock Text="Valor da fatura (R$)" Foreground="#B9B2C5"/>
                <TextBox x:Name="WaterAmount" MaxLength="15"/>
                <TextBlock Text="Consumo m³ (opcional)" Foreground="#B9B2C5"/>
                <TextBox x:Name="WaterVolume" MaxLength="15"/>
                <Button Content="Salvar conta de água" Click="AddWater_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Histórico de água" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl x:Name="WaterList" ItemTemplate="{StaticResource RecordTemplate}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Luz -->
          <StackPanel x:Name="EnergyPage" Visibility="Collapsed">
            <TextBlock Text="Conta de luz" Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Consulte e registre o valor real da conta de energia elétrica."
                       Style="{StaticResource Muted}" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Cadastrar conta de energia" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Mês (AAAA-MM)" Foreground="#B9B2C5"/>
                <TextBox x:Name="EnergyMonth" MaxLength="7"/>
                <TextBlock Text="Valor (R$)" Foreground="#B9B2C5"/>
                <TextBox x:Name="EnergyAmount" MaxLength="15"/>
                <TextBlock Text="Consumo em kWh (opcional)" Foreground="#B9B2C5"/>
                <TextBox x:Name="EnergyKwh" MaxLength="15"/>
                <Button Content="Salvar conta de luz" Click="AddEnergy_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Histórico de energia" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl x:Name="EnergyList" ItemTemplate="{StaticResource RecordTemplate}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Casa -->
          <StackPanel x:Name="HomePage" Visibility="Collapsed">
            <TextBlock Text="Minha casa" Style="{StaticResource PageHeading}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Seus cômodos" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Sala grande  •  Cozinha americana e copa integradas  •  Banheiro  •  Escritório  •  Quarto 1  •  Quarto 2"
                           Foreground="#CBB8E8" TextWrapping="Wrap" Margin="0,14,0,12"/>
                <TextBlock Text="Nesta primeira versão nativa, o cadastro dos gastos por cômodo funciona e fica sincronizado. A maquete 3D, os aparelhos e as previsões avançadas ainda pertencem à versão web; não são carregados dentro de uma página disfarçada."
                           Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,10"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Compartilhar -->
          <StackPanel x:Name="FamilyPage" Visibility="Collapsed">
            <TextBlock Text="Sua casa compartilhada" Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Conecte sua própria conta ao mesmo Supabase da versão web."
                       Style="{StaticResource Muted}" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="1. Solicitar acesso por e-mail" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Endereço de e-mail" Foreground="#B9B2C5"/>
                <TextBox x:Name="EmailInput" MaxLength="250"/>
                <Button Content="Enviar e-mail de acesso" Click="SendAccess_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="2. Copie o endereço do botão do e-mail ANTES de clicar nele, e cole aqui. O Voltara valida o link diretamente com o Supabase."
                           Style="{StaticResource Muted}" Margin="0,22,0,7"/>
                <TextBox x:Name="LoginLinkInput" MaxLength="4096"/>
                <Button Content="Entrar com link copiado" Click="ConfirmLink_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="FamilyState" Text="Nenhuma sessão iniciada." Foreground="#CBB8E8" TextWrapping="Wrap" Margin="0,16,0,8"/>
                <Button Content="Sair da conta neste PC" Click="SignOut_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="3. Compartilhar a casa" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="O dono da casa pode gerar um código; a segunda pessoa usa o mesmo código para entrar."
                           Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                <WrapPanel>
                  <Button Content="Criar minha casa" Click="CreateHouse_Click"/>
                  <Button Content="Gerar convite" Click="Invite_Click"/>
                </WrapPanel>
                <TextBlock Text="Código do convite (64 caracteres)" Foreground="#B9B2C5" Margin="0,12,0,0"/>
                <TextBox x:Name="InviteInput" MaxLength="70"/>
                <Button Content="Entrar na casa com o código" Click="JoinHouse_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#21182E" BorderBrush="#3C2E51" BorderThickness="0,1,0,0">
        <DockPanel Margin="15,0">
          <TextBlock x:Name="FooterState" VerticalAlignment="Center" Foreground="#D2C2E5" FontSize="11"
                     Text="Voltara nativo • Sem WebView2 • Sessão local temporária"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
